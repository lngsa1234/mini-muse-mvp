# Copy this file to .env and fill in your key.

# Required: your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Optional: which models each "Response style" tier uses.
# "Fast" in the UI -> OPENAI_MODEL_QUICK, "Thorough" -> OPENAI_MODEL_DEFAULT.
# Update these to models your account can access.
OPENAI_MODEL_QUICK=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o

# Optional: a model specifically for developer-side live evaluations.
# OPENAI_EVAL_MODEL=gpt-4o-mini

# Required for the Library: Neon Postgres connection string (pooled).
# Get it from the Neon dashboard → Connection Details. Then run: npm run db:init
DATABASE_URL=

# Optional: enables Muse's web_search / web_open tools. Free key (1,000
# searches/month, no credit card) from https://tavily.com. Left blank, Muse
# simply can't browse the web.
TAVILY_API_KEY=

# Google OAuth for real Gmail and Google Calendar connectors. In Google Cloud,
# create a Web application OAuth client and add GOOGLE_REDIRECT_URI exactly as
# an Authorized redirect URI (for local development: http://localhost:3000/api/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes encoded as base64. Example: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public origin used for a secure cookie and the default OAuth redirect URI.
APP_URL=http://localhost:3000

# Optional: which user owns documents until real auth is added (default "dev").
# DEV_USER_ID=dev

# Observability (tracing + logs). All optional; defaults shown.
# OBS_ENABLED=true          # set false to turn tracing off entirely
# OBS_CAPTURE_CONTENT=true  # set false to store span shapes but redact prompts/outputs/tool I/O
# OBS_SAMPLE_RATE=1.0       # fraction of turns to trace (0.0–1.0)
# OBS_RETENTION_DAYS=7      # npm run obs:purge deletes traces/spans/logs older than this
OBS_ENABLED=true
OBS_CAPTURE_CONTENT=true
OBS_SAMPLE_RATE=1.0
OBS_RETENTION_DAYS=7

# Optional
PORT=3000
