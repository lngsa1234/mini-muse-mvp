# Copy this file to .env and fill in your key.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Optional: which models each "Response style" tier uses.
# "Fast" in the UI -> MODEL_QUICK, "Thorough" -> MODEL_DEFAULT.
# Update these to whatever models your account can access, e.g.
#   MODEL_QUICK=claude-haiku-4-5
#   MODEL_DEFAULT=claude-sonnet-4-5
MODEL_QUICK=claude-3-5-haiku-latest
MODEL_DEFAULT=claude-3-7-sonnet-latest

# Optional
PORT=3000
ANTHROPIC_VERSION=2023-06-01
