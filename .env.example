# Copy this file to .env and fill in your key.

# Required: your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Optional: which models each "Response style" tier uses.
# "Fast" in the UI -> OPENAI_MODEL_QUICK, "Thorough" -> OPENAI_MODEL_DEFAULT.
# Update these to models your account can access.
OPENAI_MODEL_QUICK=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o

# Optional: a model specifically for developer-side live evaluations.
# OPENAI_EVAL_MODEL=gpt-4o-mini

# Required for the Library: Neon Postgres connection string (pooled).
# Get it from the Neon dashboard → Connection Details. Then run: npm run db:init
DATABASE_URL=

# Optional: enables Muse's web_search / web_open tools. Free key (1,000
# searches/month, no credit card) from https://tavily.com. Left blank, Muse
# simply can't browse the web.
TAVILY_API_KEY=

# Optional: which user owns documents until real auth is added (default "dev").
# DEV_USER_ID=dev

# Optional
PORT=3000
