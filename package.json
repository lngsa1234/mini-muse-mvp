{
  "name": "mini-muse",
  "version": "1.0.0",
  "description": "Mini Muse - a self-hostable personal AI agent demo (vanilla JS + Node/Express proxy to the OpenAI API).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node scripts/db-init.mjs",
    "test": "node --test",
    "evals": "node evals/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  }
}
