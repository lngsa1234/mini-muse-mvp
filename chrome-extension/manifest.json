{
  "manifest_version": 3,
  "name": "Mini Muse Browser Bridge",
  "version": "0.1.0",
  "description": "Lets Mini Muse read and fill the current Chrome tab after your approval.",
  "permissions": ["scripting", "tabs", "activeTab", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://mini-muse-project.vercel.app/*", "http://localhost:3000/*"],
    "js": ["muse-bridge.js"],
    "run_at": "document_start"
  }]
}
